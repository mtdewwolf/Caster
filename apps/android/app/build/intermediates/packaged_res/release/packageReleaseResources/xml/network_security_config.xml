<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Caster's default Tailscale endpoint is HTTP on a private WireGuard overlay. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
