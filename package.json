{
  "name": "caster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@caster/server' dev",
    "dev:server": "bun run --filter '@caster/server' dev",
    "dev:web": "bun run --filter '@caster/web' dev",
