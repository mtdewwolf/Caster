{
  "name": "caster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@caster/server' dev",
    "dev:server": "bun run --filter '@caster/server' dev",
    "dev:web": "bun run --filter '@caster/web' dev",
    "build": "bun run --filter '@caster/web' build",
    "start": "bun run --filter '@caster/server' start",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:serve": "bun tests/e2e/prepare-runtime.ts && bun run build && bun run --filter '@caster/server' start",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
